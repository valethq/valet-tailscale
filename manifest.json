{
  "schema": 1,
  "id": "valet-tailscale",
  "name": "Tailscale Serve",
  "version": "0.1.0",
  "description": "Serves a local port over tailscale serve or funnel. Defaults to the valet-ui port.",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["settings@1"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": { "type": "string", "enum": ["serve", "funnel"] },
      "httpsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
      "target": { "type": "string" },
      "command": { "type": "string" }
    }
  }
}
