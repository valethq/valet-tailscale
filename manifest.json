{
  "schema": 1,
  "id": "valet-tailscale",
  "name": "Tailscale Serve",
  "version": "0.1.0",
  "description": "Serves a local port over tailscale serve or funnel. Defaults to the valet-ui port.",
  "valet": "^0.1.0",
  "main": "./src/index.ts",
  "provides": ["settings@2"],
  "settings": {
    "sections": {
      "system": {
        "subsections": [
          {
            "id": "exposure",
            "label": "Exposure",
            "items": [
              {
                "id": "mode",
                "label": "Exposure",
                "summary": "Funnel puts the port on the public internet. Tailscale refuses ports it does not allow for funnel.",
                "input": {
                  "type": "select",
                  "options": [
                    {
                      "value": "serve",
                      "label": "Tailnet only (serve)"
                    },
                    {
                      "value": "funnel",
                      "label": "Public internet (funnel)"
                    }
                  ],
                  "default": "serve",
                  "style": "segmented"
                }
              },
              {
                "id": "httpsPort",
                "label": "HTTPS port",
                "summary": "Port on the tailnet (or public) side. 443 unless you serve a second service.",
                "input": {
                  "type": "int",
                  "min": 1,
                  "max": 65535,
                  "default": 443
                }
              },
              {
                "id": "target",
                "label": "Target",
                "summary": "Port, host:port, URL or unix:/path.sock. Blank serves the valet-ui address.",
                "input": {
                  "type": "string"
                }
              },
              {
                "id": "command",
                "label": "CLI command",
                "summary": "Binary to run, may include args. Use \"sudo tailscale\" when serve config needs root.",
                "input": {
                  "type": "string",
                  "default": "tailscale"
                },
                "advanced": true
              }
            ]
          }
        ]
      }
    }
  }
}
